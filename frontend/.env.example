# Supabase — use the project base URL only (Dashboard → Settings → API → Project URL).
# Do NOT add /rest/v1/ — @supabase/supabase-js attaches API paths automatically.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Same values for SSR (middleware / server). Optional if unused.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Dev only: legacy Express `/uploads/...` (optional).
VITE_API_URL=http://localhost:5000

# Optional Snapchat cover: your own screenshot (put file in public/, e.g. /snap-decoy.png).
# VITE_DECOY_IMAGE_URL=/snap-decoy.png
